# Copiez ce fichier en .env puis changez les valeurs :
#   Copy-Item .env.example .env
# Ne commitez JAMAIS le fichier .env (il est dans .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=whatsapp
POSTGRES_PASSWORD=change_me
POSTGRES_DB=whatsapp
# 5433 côté Windows pour ne pas entrer en conflit avec un PostgreSQL déjà installé sur 5432.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://whatsapp:change_me@localhost:5433/whatsapp

# --- MinIO (stockage des médias, compatible S3) ---
# Le mot de passe doit faire au moins 8 caractères.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_please
MINIO_ENDPOINT=http://localhost:9000

# --- coturn (STUN/TURN) ---
TURN_USER=turnuser
TURN_PASSWORD=change_me
TURN_REALM=whatsapp.local
# En local : 127.0.0.1. En production : l'IP publique du serveur.
TURN_EXTERNAL_IP=127.0.0.1

# --- Backend ---
BACKEND_PORT=4000

# --- Authentification ---
# Deux secrets DIFFÉRENTS, longs et aléatoires. Pour en générer un en PowerShell :
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_ACCESS_SECRET=remplacez_moi_par_une_longue_valeur_aleatoire
JWT_REFRESH_SECRET=remplacez_moi_par_une_autre_longue_valeur_aleatoire
# Coût de bcrypt (chaque +1 double le temps de calcul). 12 est un bon défaut.
BCRYPT_ROUNDS=12

# --- Tests ---
# Base dédiée aux tests (créée et migrée automatiquement par `npm test`, vidée entre chaque test).
TEST_DATABASE_URL=postgresql://whatsapp:change_me@localhost:5433/whatsapp_test
